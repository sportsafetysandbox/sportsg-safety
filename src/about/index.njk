---
layout: base.njk
title: About Sport Safety
description: "Mission, governance, and policy framework for sport safety in Singapore."
---
<div class="wrap" style="padding-top:1.5rem;">
  <p class="breadcrumb"><a href="/">Home</a> / About Sport Safety</p>
</div>

<section>
  <div class="wrap">
    <h1>About Sport Safety</h1>
    <p class="lede">Protecting athletes, participants, employees and partners from harm, physical injury, environmental hazards, and abuse through proper risk assessment, planning and management.</p>
  </div>
</section>

{% for row in about %}
  {% if row.type == "Framework" %}
    <section>
      <div class="wrap" style="display:grid; grid-template-columns:1fr 1fr; gap:2rem; align-items:start;">
        <div>
          <h2>{{ row.section }}</h2>
          {% for para in row.body.split('\n\n') %}<p>{{ para }}</p>{% endfor %}
          <a class="btn outline" href="/safety-framework/" style="margin-top:0.5rem;">Read More →</a>
        </div>
        <img src="{{ row.image }}" alt="Safety framework diagram" style="border-radius:8px;">
      </div>
    </section>
  {% endif %}
{% endfor %}

<section>
  <div class="wrap">
    <h2>Policies</h2>
    <div class="grid-cards cols-4">
      {% for row in about %}
        {% if row.type == "Policy" %}
          <button class="card policy-card"
            data-policy-title="{{ row.section }}"
            data-policy-body="{{ row.body }}"
            data-policy-link="{{ row.link }}">
            <h3>{{ row.section }}</h3>
            <p>{{ row.body }}</p>
            <span class="link">View document →</span>
          </button>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- Policy modal -->
<div class="policy-modal" id="policy-modal" role="dialog" aria-modal="true" aria-labelledby="policy-modal-title" hidden>
  <div class="policy-modal__backdrop"></div>
  <div class="policy-modal__panel">
    <div class="policy-modal__header">
      <h2 id="policy-modal-title" class="policy-modal__title"></h2>
      <div class="policy-modal__actions">
        <a class="btn" id="policy-modal-download" href="#" download target="_blank">Download PDF</a>
        <button class="policy-modal__close" id="policy-modal-close" aria-label="Close">✕</button>
      </div>
    </div>
    <div class="policy-modal__body">
      <p class="policy-modal__desc" id="policy-modal-desc"></p>
      <div class="policy-modal__viewer">
        <iframe id="policy-modal-iframe" title="Policy document" src="" allowfullscreen></iframe>
        <div class="policy-modal__unavailable" id="policy-modal-unavailable" hidden>
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
          <p>This document is not yet available. Please check back later or contact us for more information.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<section>
  <div class="wrap narrow">
    {% for row in about %}
      {% if row.type == "Narrative" %}
        <h2>{{ row.section }}</h2>
        {% for para in row.body.split('\n\n') %}<p>{{ para }}</p>{% endfor %}
      {% endif %}
    {% endfor %}
  </div>
</section>

<section>
  <div class="wrap">
    <div class="list-row"><span>Sport safety enquiries</span><a class="link" href="/faq/">See FAQ &amp; Support →</a></div>
    <div class="list-row"><span>Urgent safety escalation</span><a class="link" href="/report/">Report an Incident/Hazard →</a></div>
  </div>
</section>
