---
layout: base.njk
title: About Sport Safety
description: "Mission, governance, and policy framework for sport safety in Singapore."
---
<div class="wrap" style="padding-top:1.5rem;">
  <p class="breadcrumb"><a href="/">Home</a> / About Sport Safety</p>
</div>

<section>
  <div class="wrap">
    <h1>About Sport Safety</h1>
    <p class="lede">Protecting athletes, participants, employees and partners from harm, physical injury, environmental hazards, and abuse through proper risk assessment, planning and management.</p>
  </div>
</section>

{% for row in about %}
  {% if row.type == "Framework" %}
    <section>
      <div class="wrap" style="display:grid; grid-template-columns:1fr 1fr; gap:2rem; align-items:start;">
        <div>
          <h2>{{ row.section }}</h2>
          {% for para in row.body.split('\n\n') %}<p>{{ para }}</p>{% endfor %}
          <a class="btn outline" href="/safety-framework/" style="margin-top:0.5rem;">Read More →</a>
        </div>
        <button class="framework-trigger" type="button" aria-label="View enlarged Safety Framework diagram">
          <img src="{{ row.image }}" alt="Safety framework diagram">
        </button>
      </div>
    </section>
  {% endif %}
{% endfor %}

<section>
  <div class="wrap">
    <h2>Policies</h2>
    <div class="grid-cards cols-4">
      {% for row in about %}
        {% if row.type == "Policy" %}
          <button class="card policy-card"
            data-policy-id="{{ row.id }}"
            data-policy-title="{{ row.section }}"
            data-policy-link="{{ row.link }}"
            data-policy-color="{{ row.headerColor }}">
            <h3>{{ row.section }}</h3>
            <p>{{ row.body }}</p>
            <span class="link">View document →</span>
          </button>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- Hidden policy content blocks, one per policy -->
{% for row in about %}
  {% if row.type == "Policy" %}
    <div id="policy-content-{{ row.id }}" hidden>
      {% for section in row.content %}
        <h3>{{ section.heading }}</h3>
        <p>{{ section.text }}</p>
      {% endfor %}
    </div>
  {% endif %}
{% endfor %}

<!-- Framework diagram modal -->
<div class="framework-modal" id="framework-modal" role="dialog" aria-modal="true" aria-labelledby="framework-modal-title" hidden>
  <div class="framework-modal__backdrop"></div>
  <div class="framework-modal__panel">
    <div class="framework-modal__header">
      <h2 id="framework-modal-title" class="framework-modal__title">Safety Framework</h2>
      <button class="framework-modal__close" id="framework-modal-close" aria-label="Close">✕</button>
    </div>
    <div class="framework-modal__body">
      {% for row in about %}
        {% if row.type == "Framework" %}
          <img src="{{ row.image }}" alt="Safety framework diagram — enlarged view">
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<!-- Policy modal -->
<div class="policy-modal" id="policy-modal" role="dialog" aria-modal="true" aria-labelledby="policy-modal-title" hidden>
  <div class="policy-modal__backdrop"></div>
  <div class="policy-modal__panel">
    <div class="policy-modal__header">
      <h2 id="policy-modal-title" class="policy-modal__title"></h2>
      <div class="policy-modal__actions">
        <a class="btn" id="policy-modal-download" href="#" download target="_blank" hidden>Download PDF</a>
        <button class="policy-modal__close" id="policy-modal-close" aria-label="Close">✕</button>
      </div>
    </div>
    <div class="policy-modal__content" id="policy-modal-content"></div>
  </div>
</div>

<section>
  <div class="wrap narrow">
    {% for row in about %}
      {% if row.type == "Narrative" %}
        <h2>{{ row.section }}</h2>
        {% for para in row.body.split('\n\n') %}<p>{{ para }}</p>{% endfor %}
      {% endif %}
    {% endfor %}
  </div>
</section>

<section>
  <div class="wrap">
    <div class="list-row"><span>Sport safety enquiries</span><a class="link" href="/faq/">See FAQ &amp; Support →</a></div>
    <div class="list-row"><span>Urgent safety escalation</span><a class="link" href="/report/">Report an Incident/Hazard →</a></div>
  </div>
</section>
