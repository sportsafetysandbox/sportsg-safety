---
layout: base.njk
title: Safety Resources
description: "Code of Practice, Standards, Checklists and Toolkits for the sport ecosystem."
---
<div class="wrap" style="padding-top:1.5rem;">
  <p class="breadcrumb"><a href="/">Home</a> / Safety Resources</p>
</div>

<section>
  <div class="wrap">
    <h1>Safety Resources</h1>
    <p class="lede">Code of Practice, Standards, Checklists and Toolkits for everyone in the sport ecosystem.</p>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="filter-bar" data-filter-group="resource-grid">
      <button type="button" class="btn" data-filter="all" aria-pressed="true">All</button>
      <button type="button" class="btn outline" data-filter="Code of Practice" aria-pressed="false">Code of Practice</button>
      <button type="button" class="btn outline" data-filter="Standards" aria-pressed="false">Standards</button>
      <button type="button" class="btn outline" data-filter="Checklists" aria-pressed="false">Checklists</button>
      <button type="button" class="btn outline" data-filter="Toolkits & Templates" aria-pressed="false">Toolkits &amp; Templates</button>
    </div>
    <div class="grid-cards cols-4" id="resource-grid">
      {% for item in resources %}
        <div class="card resource-card" data-filter-value="{{ item.type }}">
          <span class="tag type">{{ item.type }}</span>
          <h3>{{ item.title }}</h3>
          <p class="meta">{{ item.topic | join(", ") }} · {{ item.audience | join(", ") }}</p>
          {% if item.cover %}
            <a href="{{ item.link }}" target="_blank" rel="noopener noreferrer" class="resource-card__cover-link" tabindex="-1" aria-hidden="true">
              <img src="{{ item.cover }}" alt="Cover — {{ item.title }}" class="resource-card__cover">
            </a>
          {% endif %}
          <a class="link" href="{{ item.link }}"{% if item.link != "#" %} target="_blank" rel="noopener noreferrer"{% endif %}>View →</a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
