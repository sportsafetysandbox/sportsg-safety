<header class="site-header">
  <div class="topbar">
    <div class="wrap-header">
      <a class="brand" href="/">
        <span class="mark" aria-hidden="true"></span>
        {{ site.title }}
      </a>
      <div class="topbar-actions">
        <span class="lang">EN</span>
        <form class="search-form" role="search" action="#" onsubmit="return false;">
          <input type="search" class="search-input" name="q" placeholder="Search" aria-label="Search">
          <button type="submit" class="search-submit" aria-label="Search">
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="6.5" stroke="currentColor" stroke-width="1.6"/><line x1="13.6" y1="13.6" x2="18" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </button>
        </form>
        <a class="btn" href="/report/">Report an Incident/Hazard</a>
      </div>
    </div>
  </div>
  <div class="navbar">
    <div class="wrap-header">
      <button type="button" class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="primary-nav">
        <span aria-hidden="true">☰</span>
      </button>
      <nav class="primary-nav" id="primary-nav" aria-label="Primary">
        {% for item in site.nav %}
          {% if item.dropdown %}
            <div class="nav-item">
              <button type="button" aria-haspopup="true" aria-expanded="false">{{ item.label }}</button>
              <div class="dropdown">
                {% for d in item.dropdown %}
                  <a href="{{ d.url }}">
                    {{ d.label }}
                    <span class="desc">{{ d.desc }}</span>
                  </a>
                {% endfor %}
              </div>
            </div>
          {% else %}
            <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
          {% endif %}
        {% endfor %}
      </nav>
    </div>
  </div>
</header>
